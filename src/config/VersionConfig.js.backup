// Version Configuration
// This file is automatically updated on each commit

export const VersionConfig = {
    // App version - will be updated by git hooks
    version: '1.0.4',
    
    // Build information
    buildDate: '2025-07-20',
    buildTime: '21:42:35',
    
    // Git information (will be populated by build process)
    gitCommit: 'f9449cf',
    gitBranch: 'publish_website',
    
    // App metadata
    appName: 'Poker Game',
    appDescription: 'Multiplayer Poker Game with AI and Telegram Integration',
    developer: 'Ncit',
    
    // Platform support
    platforms: ['Web', 'Telegram Mini App', 'VK Mini App'],
    
    // Features
    features: [
        'Multiplayer Poker',
        'AI Bot Training',
        'Telegram Integration',
        'VK Integration',
        'Real-time Chat',
        'Card Animations',
        'Responsive Design'
    ],
    
    // Technical details
    engine: 'Phaser 3',
    framework: 'JavaScript ES6+',
    networking: 'WebSocket',
    
    // Contact information
    support: {
        email: 'support@example.com',
        telegram: '@poker_support',
        website: 'https://github.com/Ncit/phaserv2'
    }
};

// Helper function to get formatted version string
export function getVersionString() {
    return `${VersionConfig.appName} v${VersionConfig.version} (${VersionConfig.gitCommit})`;
}

// Helper function to get detailed version info
export function getVersionInfo() {
    return {
        version: VersionConfig.version,
        commit: VersionConfig.gitCommit,
        branch: VersionConfig.gitBranch,
        buildDate: VersionConfig.buildDate,
        buildTime: VersionConfig.buildTime,
        engine: VersionConfig.engine,
        platforms: VersionConfig.platforms
    };
} 